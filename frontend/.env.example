# ─────────────────────────────────────────────────────────────────────────────
# TrackWise Frontend — Environment Variables
#
# HOW TO USE
#   1. Copy:  copy .env.example .env.local
#   2. Fill in real values. NEVER commit .env.local to version control.
#
# All VITE_* variables are inlined at build time by Vite.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_NAME=TrackWise
VITE_APP_ENV=development

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for the Spring Boot backend. The Vite dev server proxy forwards
# /api/* to this target automatically during development.
VITE_API_BASE_URL=http://localhost:8080/api/v1
