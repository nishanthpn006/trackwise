# ─────────────────────────────────────────────────────────────────────────────
# TrackWise — Root Environment Variables Example
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# WARNING: Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name created inside the postgres container
POSTGRES_DB=trackwise

# PostgreSQL superuser for the trackwise database
POSTGRES_USER=trackwise

# REQUIRED — strong password, no defaults
POSTGRES_PASSWORD=change_me_strong_password

# ── Backend ───────────────────────────────────────────────────────────────────
# JWT secret: minimum 64-character hex string
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret_generated_by_openssl_rand_hex_32

# Token lifetime in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# HikariCP pool size (optional, default: 10)
DB_POOL_SIZE=10

# ── Frontend ──────────────────────────────────────────────────────────────────
# Host port that maps to Nginx :80 inside the container
FRONTEND_PORT=80
